# ---------------------------------------------------------------------------
# Market data providers  (SERVER-SIDE ONLY — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Twelve Data — live quotes and time series.  Free tier: 800 calls/day, 8/min.
# https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Alpha Vantage — news & sentiment feed.
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Database (Phase 2 — live data pipeline)
# ---------------------------------------------------------------------------
DATABASE_URL=

# Shared secret required by /api/cron/refresh so the job cannot be triggered
# by anyone but the scheduler.  Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Analytics (optional, public by design — measurement IDs are not secrets)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_CONTAINER_ID=
